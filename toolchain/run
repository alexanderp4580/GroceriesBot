#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mkdir -p "$ROOT/.local/go-cache" "$ROOT/.local/go-mod"
exec podman run --rm -i --network=host --volume "$ROOT:/workspace:Z" --workdir /workspace \
  --env GOCACHE=/workspace/.local/go-cache --env GOMODCACHE=/workspace/.local/go-mod \
  --env GOFLAGS=-buildvcs=false docker.io/library/golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 "$@"
